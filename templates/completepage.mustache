{{!
    @template mod_questionnaire/completepage

    Template which defines a questionnaire completion page.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    The response form has id phpesp_response (mod_questionnaire/attempt_form and mod_questionnaire/survey_inputs).

    Context variables required for this template: (Note sections have been used to allow non-inclusion)
    * notifications - string: HTML of any notifications loaded.
    * respondentinfo - string: HTML of any specific response/respondent information.
    * links - array: url and label (formatted) of each button link, e.g. back to the course after saving.
    * surveyheader - object: survey_header export, rendered by the mod_questionnaire/survey_header partial.
    * message - string: Any message HTML text.
    * form - object|null: action and hidden (name/value pairs) of the response form.
    * questions - array: Array of questions HTML.
    * pageinfo - string: Page navigation HTML if present.
    * controlbuttons - array: type, name, class and value of each form button (or hidden field).
    * noquestions - string|null: Message shown instead of the buttons when there are no questions.

    Example context (json):
    {
        "notifications": "<div>Notification one</div>",
        "respondentinfo": "<div>This is respondent information</div>",
        "links": [],
        "surveyheader": {
            "title": "Test Questionnaire",
            "subtitle": "This is a subtitle",
            "info": "<div>This is additional information.</div>"
        },
        "message": "<div>This is a message.</div>",
        "form": {
            "action": "https://example.com/mod/questionnaire/complete.php?id=2",
            "hidden": [{"name": "sesskey", "value": "abc123"}]
        },
        "questions": [
            "<div>Question 1 HTML</div>",
            "<div>Question 2 HTML</div>"
        ],
        "pageinfo": "<div>This is the page information.</div>",
        "controlbuttons": [
            {"type": "submit", "name": "submit", "class": "btn btn-primary", "value": "Submit questionnaire"}
        ]
    }
    }}
<div class="mod_questionnaire_completepage generalbox">
    {{#notifications}}{{{.}}}{{/notifications}}
    {{{respondentinfo}}}
    {{#links}}
    <div class="homelink"><a href="{{url}}" class="btn btn-primary">{{{label}}}</a></div>
    {{/links}}
    {{#surveyheader}}{{> mod_questionnaire/survey_header}}{{/surveyheader}}
    {{#progressbar}}<div class="progressbar">{{{.}}}</div>{{/progressbar}}
    {{#message}}<div class="message">{{{.}}}</div>{{/message}}
    {{#continue}}{{{continue}}}{{/continue}}
    <div class="generalbox">
        {{#form}}
        <form id="phpesp_response" method="post" action="{{action}}">
            {{#hidden}}
            <input type="hidden" name="{{name}}" value="{{value}}">
            {{/hidden}}
        {{/form}}
        {{#questions}}{{{.}}}{{/questions}}
        {{#pageinfo}}{{{.}}}{{/pageinfo}}
        <div class="notice">
            <div class="buttons mod_questionnaire_controlbuttons">
                {{#controlbuttons}}
                <input type="{{type}}" name="{{name}}" class="{{class}}" value="{{value}}">
                {{/controlbuttons}}
                {{#noquestions}}<p>{{.}}</p>{{/noquestions}}
            </div>
        </div>
        {{#form}}
        </form>
        {{/form}}
    </div>
</div>
{{#form}}
{{#js}}
    require(['mod_questionnaire/attempt_form', 'mod_questionnaire/survey_inputs'], function(AttemptForm, SurveyInputs) {
        AttemptForm.init();
        SurveyInputs.init();
    });
{{/js}}
{{/form}}
