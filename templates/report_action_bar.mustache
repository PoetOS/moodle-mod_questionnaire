{{!
    @template mod_questionnaire/report_action_bar

    Tertiary action bar for the response report and my-report pages: view-switch links,
    response ordering select, download link, and an optional right-aligned danger action.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * left - array: items, each with an "actionlink" (core/action_link context) or
      "urlselect" (core/url_select context) key.
    * danger - object: optional core/action_link context for the destructive action.

    Example context (json):
    {
        "left": [
            {
                "actionlink": {
                    "url": "#",
                    "id": "view-summary",
                    "classes": "btn btn-link px-2",
                    "attributes": [],
                    "text": "Summary"
                }
            },
            {
                "urlselect": {
                    "id": "url_select_test",
                    "action": "https://example.com/post",
                    "formid": "url_select_form",
                    "sesskey": "sesskey",
                    "label": "Order Responses",
                    "showbutton": null,
                    "options": [
                        {"name": "View Default order", "isgroup": false, "value": "1"},
                        {"name": "Ascending order", "isgroup": false, "value": "2"}
                    ]
                }
            }
        ],
        "danger": {
            "url": "#",
            "id": "delete-all",
            "classes": "btn btn-outline-danger",
            "attributes": [],
            "text": "Delete ALL Responses"
        }
    }
}}
<div class="container-fluid tertiary-navigation mod_questionnaire_report_action_bar">
    <div class="d-flex flex-wrap align-items-center">
        {{#left}}
            {{#actionlink}}
                <div class="navitem">
                    {{> core/action_link}}
                </div>
            {{/actionlink}}
            {{#urlselect}}
                <div class="navitem">
                    {{> core/url_select}}
                </div>
            {{/urlselect}}
        {{/left}}
        {{#danger}}
            <div class="navitem ms-sm-auto">
                {{> core/action_link}}
            </div>
        {{/danger}}
    </div>
</div>
