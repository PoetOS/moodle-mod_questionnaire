{{!
    @template mod_questionnaire/dependencylist

    Displays the list of parent question dependencies for a question.

    Context variables required for this template:

    Example context (json):
    {
        "dependencies": [
            {
                "divid": "qdepend_7_3_1",
                "divclass": "qdepend",
                "dependquestion": "Dependent on question",
                "position": "Position",
                "parentposition": "2",
                "parent": "Parent question text",
                "logicstr": "set"
            }
        ]
    }
}}
{{#dependencies}}
<div id="{{divid}}" class="{{divclass}}"><strong>{{dependquestion}}</strong> : {{position}} {{parentposition}} ({{parent}}) {{logicstr}}</div>
{{/dependencies}}
