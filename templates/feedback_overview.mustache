{{!
    @template mod_questionnaire/feedback_overview

    The feedback sections list below the feedback settings form, or the empty state when no
    question can be used for feedback.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * noeligible - bool: No question qualifies for feedback.
    * eligiblehelp - string: HTML explaining which questions qualify (empty state only).
    * questionsurl - string: The manage-questions page (empty state only).
    * showsections - bool: Show the sections list (a feedback mode is on).
    * isglobal - bool: Global feedback mode (one section, no add/delete).
    * sections - array: label, questions (count or text), messages (count), editurl, deleteurl (null in global mode).
    * hassections - bool: At least one section is listed.
    * canadd - bool: Show the add-section form.
    * addurl - string: Where the add-section form posts.
    * cmid - int: The course module id.
    * sesskey - string: The session key.
    * defaultlabel - string: The add form's default label.
    * unusednotice - string: Notice about sections kept from another mode, or null.

    Example context (json):
    {
        "noeligible": false,
        "showsections": true,
        "isglobal": false,
        "sections": [
            {"label": "Extraversion", "questions": 3, "messages": 2, "editurl": "#", "deleteurl": "#"},
            {"label": "Openness", "questions": 0, "messages": 0, "editurl": "#", "deleteurl": "#"}
        ],
        "hassections": true,
        "canadd": true,
        "addurl": "#",
        "cmid": 1,
        "sesskey": "abc",
        "defaultlabel": "",
        "unusednotice": null
    }
}}
<div class="mod_questionnaire_feedback_overview mt-4">
    {{#noeligible}}
        <div class="alert alert-info">
            <p class="fw-bold">{{#str}} feedbacknoeligiblequestions, questionnaire {{/str}}</p>
            {{{eligiblehelp}}}
            <a href="{{questionsurl}}">{{#str}} managequestions, questionnaire {{/str}}</a>
        </div>
    {{/noeligible}}
    {{#showsections}}
        <h3>{{#isglobal}}{{#str}} feedbackglobal, questionnaire {{/str}}{{/isglobal}}{{^isglobal}}{{#str}} feedbacksections, questionnaire {{/str}}{{/isglobal}}</h3>
        {{#unusednotice}}
            <div class="alert alert-warning">{{.}}</div>
        {{/unusednotice}}
        {{#hassections}}
            <div class="table-responsive">
            <table class="generaltable table-sm">
                <thead>
                    <tr>
                        <th scope="col">{{#str}} feedbacksectionlabel, questionnaire {{/str}}</th>
                        <th scope="col">{{#str}} questions, questionnaire {{/str}}</th>
                        <th scope="col">{{#str}} feedbackmessagecount, questionnaire {{/str}}</th>
                        <th scope="col"><span class="visually-hidden">{{#str}} actions {{/str}}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {{#sections}}
                        <tr>
                            <td>{{label}}</td>
                            <td>{{questions}}</td>
                            <td>{{messages}}</td>
                            <td class="text-nowrap">
                                <a href="{{editurl}}" class="btn btn-sm btn-secondary">{{#str}} edit {{/str}}<span class="visually-hidden"> {{label}}</span></a>
                                {{#deleteurl}}
                                    <a href="{{deleteurl}}" class="btn btn-sm btn-outline-danger ms-2">{{#str}} delete {{/str}}<span class="visually-hidden"> {{label}}</span></a>
                                {{/deleteurl}}
                            </td>
                        </tr>
                    {{/sections}}
                </tbody>
            </table>
            </div>
        {{/hassections}}
        {{^hassections}}
            <p>{{#str}} feedbacknosections, questionnaire {{/str}}</p>
        {{/hassections}}
        {{#canadd}}
            <form method="post" action="{{addurl}}" class="d-flex flex-wrap align-items-end gap-2">
                <input type="hidden" name="id" value="{{cmid}}">
                <input type="hidden" name="action" value="addsection">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <div>
                    <label for="mod_questionnaire_newsectionlabel" class="form-label">{{#str}} feedbacknewsectionlabel, questionnaire {{/str}}</label>
                    <input type="text" id="mod_questionnaire_newsectionlabel" name="sectionlabel" class="form-control" maxlength="50" value="{{defaultlabel}}">
                </div>
                <button type="submit" class="btn btn-secondary">{{#str}} addnewsection, questionnaire {{/str}}</button>
            </form>
        {{/canadd}}
    {{/showsections}}
</div>
