{{!
    @template mod_questionnaire/viewpage

    The questionnaire landing page: access message, action buttons, open/close information
    and the log-in prompt for guests.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * message - string|null: Why the user cannot answer, or that there are no questions (plain text).
    * hasactions - bool: Whether any action buttons are offered.
    * actions - array: Action buttons, each with url and label.
    * hasinfo - bool: Whether any information lines are shown.
    * info - array: Attempts allowed / opened at / closes at lines (plain text).
    * guestconfirm - string|null: Rendered log-in confirmation for guests (HTML).

    Example context (json):
    {
        "message": null,
        "hasactions": true,
        "actions": [
            {"url": "https://example.com/mod/questionnaire/complete.php?id=2", "label": "Answer the questions..."},
            {"url": "https://example.com/mod/questionnaire/report.php?instance=1&group=0", "label": "View all responses"}
        ],
        "hasinfo": true,
        "info": ["Attempts allowed: once", "Closes at Friday, 30 October 2026, 5:00 PM"],
        "guestconfirm": null
    }
}}
<div class="mod_questionnaire_viewpage">
    {{#message}}
    <div class="message mb-3">{{message}}</div>
    {{/message}}
    {{#guestconfirm}}
    <div class="guestuser mb-3">{{{guestconfirm}}}</div>
    {{/guestconfirm}}
    {{#hasactions}}
    <div class="d-flex flex-wrap gap-2 mb-3">
        {{#actions}}
        <a href="{{url}}" class="btn btn-primary">{{label}}</a>
        {{/actions}}
    </div>
    {{/hasactions}}
    {{#hasinfo}}
    <ul class="info list-unstyled">
        {{#info}}
        <li>{{.}}</li>
        {{/info}}
    </ul>
    {{/hasinfo}}
</div>
